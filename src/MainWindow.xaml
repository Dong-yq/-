<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="薪资秒表" Width="412" Height="606" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#252922" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#7F847A"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#58604F"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E1E4D9"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,2"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#252922"/>
      <Setter Property="CaretBrush" Value="#252922"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#6E8050"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DayButton" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#7F847A"/><Setter Property="Background" Value="#EEEFE8"/>
      <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#657746"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
   <Viewbox x:Name="Viewport" Stretch="Fill">
    <Grid x:Name="DesignRoot" Width="412" Height="606">
     <Grid Margin="12">
    <Border x:Name="PanelShell" Background="#FBFCF7" CornerRadius="23" BorderBrush="#DDE2D4" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.13" Color="#43502F"/></Border.Effect>
      <Grid Margin="25,21,25,19">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="19"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
        <Grid x:Name="DragHeader" Background="Transparent" Cursor="SizeAll">
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" Background="#F2DB9B" CornerRadius="12" HorizontalAlignment="Left"><TextBlock Text="¥" FontSize="24" FontWeight="SemiBold" Foreground="#8A641B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="薪资秒表" FontSize="17" FontWeight="Bold"/><TextBlock Text="MAKE EVERY SECOND COUNT" FontSize="7.5" Foreground="#8D9484" Margin="0,3,0,0"/></StackPanel>
          <Button x:Name="PinButton" Grid.Column="2" Content="⌖" FontSize="19" Padding="0" ToolTip="切换窗口置顶"/>
          <Button x:Name="MinimizeButton" Grid.Column="3" Content="−" FontSize="21" Padding="0" ToolTip="收起为悬浮球"/>
          <Button x:Name="CloseButton" Grid.Column="4" Content="×" FontSize="20" Padding="0" ToolTip="退出秒表"/>
        </Grid>
        <Border Grid.Row="2" Background="#EEEFE8" CornerRadius="10" Padding="3">
          <UniformGrid Columns="2"><Button x:Name="DashboardTab" Content="今日收入" Background="White" FontWeight="SemiBold" Padding="0"/><Button x:Name="SettingsTab" Content="工作设置" Padding="0"/></UniformGrid>
        </Border>
        <Grid x:Name="Dashboard" Grid.Row="3" Margin="0,23,0,0">
          <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="67"/><RowDefinition Height="35"/><RowDefinition Height="74"/><RowDefinition Height="71"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="今日已赚" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <Button x:Name="PrivacyButton" Content="◉" HorizontalAlignment="Right" ToolTip="隐藏 / 显示金额" Padding="9,2"/>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="¥" FontSize="29" FontWeight="SemiBold" Margin="0,10,5,0"/>
            <TextBlock x:Name="EarnedText" Text="0.00" FontFamily="Bahnschrift, Segoe UI" FontSize="53" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="1,7,0,0"><Ellipse x:Name="StatusDot" Fill="#6D884C" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock x:Name="StateText" Text="正在计薪" FontSize="11" Foreground="#6D7E55"/><TextBlock Text=" · " FontSize="11" Foreground="#A5AC9A"/><TextBlock x:Name="MessageText" FontSize="11" Foreground="#8A9181"/></StackPanel>
          <Border Grid.Row="3" CornerRadius="12" Background="#F0F3E9" Padding="15,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="每秒收入" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RateText" Text="¥ 0.0104" FontFamily="Bahnschrift, Segoe UI" FontSize="20" Margin="0,7,0,0"/></StackPanel>
              <Border Grid.Column="1" BorderBrush="#DEE4D3" BorderThickness="1,0,0,0" Padding="18,0,0,0"><StackPanel><TextBlock Text="今日目标" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GoalText" Text="¥ 300.00" FontFamily="Bahnschrift, Segoe UI" FontSize="20" Margin="0,7,0,0"/></StackPanel></Border>
            </Grid>
          </Border>
          <Grid Grid.Row="4" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="今日进度" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PercentText" HorizontalAlignment="Right" FontFamily="Bahnschrift, Segoe UI" FontSize="13" Foreground="#657746"/>
            <Border Grid.Row="1" CornerRadius="3" Background="#E5E9DE"><Grid><Border x:Name="ProgressFill" CornerRadius="3" Background="#778D54" HorizontalAlignment="Left" Width="0"/></Grid></Border>
            <TextBlock x:Name="ScheduleText" Grid.Row="2" FontSize="10" Foreground="#9CA28F" Margin="0,9,0,0"/>
          </Grid>
          <Grid Grid.Row="5" Margin="0,21,0,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="距下班" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="CountdownText" HorizontalAlignment="Right" FontFamily="Bahnschrift, Segoe UI" FontSize="26" VerticalAlignment="Center"/></Grid>
            <Button x:Name="FloatButton" Grid.Row="1" Content="◌   收起为悬浮球" Background="#657746" Foreground="White" FontWeight="SemiBold" Height="40" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
        <Grid x:Name="SettingsPage" Grid.Row="3" Visibility="Collapsed" Margin="0,19,0,0">
          <StackPanel>
            <Grid><TextBlock Text="日薪" FontSize="12"/><TextBlock Text="人民币 / 工作日" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
            <TextBox x:Name="PayInput" AutomationProperties.Name="日薪" Margin="0,7,0,12" Height="40"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="上班时间" FontSize="12"/><TextBox x:Name="StartInput" AutomationProperties.Name="上班时间" Margin="0,7,0,0" Height="39"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="下班时间" FontSize="12"/><TextBox x:Name="EndInput" AutomationProperties.Name="下班时间" Margin="0,7,0,0" Height="39"/></StackPanel>
            </Grid>
            <CheckBox x:Name="LunchCheck" Content="扣除休息时间" Margin="0,15,0,8" FontSize="12" Foreground="#616A54"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBox x:Name="LunchStartInput" AutomationProperties.Name="休息开始时间" Height="37"/><TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#A1A793"/>
              <TextBox x:Name="LunchEndInput" AutomationProperties.Name="休息结束时间" Grid.Column="2" Height="37"/>
            </Grid>
            <TextBlock Text="工作日" FontSize="12" Margin="0,15,0,8"/>
            <UniformGrid x:Name="DaysGrid" Columns="7">
              <ToggleButton x:Name="Day1" Content="一" Style="{StaticResource DayButton}"/>
              <ToggleButton x:Name="Day2" Content="二" Style="{StaticResource DayButton}"/>
              <ToggleButton x:Name="Day3" Content="三" Style="{StaticResource DayButton}"/>
              <ToggleButton x:Name="Day4" Content="四" Style="{StaticResource DayButton}"/>
              <ToggleButton x:Name="Day5" Content="五" Style="{StaticResource DayButton}"/>
              <ToggleButton x:Name="Day6" Content="六" Style="{StaticResource DayButton}"/>
              <ToggleButton x:Name="Day0" Content="日" Style="{StaticResource DayButton}"/>
            </UniformGrid>
            <TextBlock x:Name="ValidationText" Text="秒薪 = 日薪 ÷ 有效工作秒数，支持跨夜班次。" FontSize="10" Foreground="#8D9484" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="32"/>
            <Button x:Name="SaveButton" Content="保存设置" Background="#657746" Foreground="White" FontWeight="SemiBold" Height="40" Margin="0,7,0,0"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="4" VerticalAlignment="Bottom"><TextBlock x:Name="ClockText" Foreground="#9CA28F" FontSize="10"/><TextBlock Text="收入按班次自动累计" Foreground="#9CA28F" FontSize="10" HorizontalAlignment="Right"/></Grid>
      </Grid>
    </Border>
    <Border x:Name="BallShell" Visibility="Collapsed" Background="#FBFCF7" BorderBrush="#DDE2D4" BorderThickness="1" CornerRadius="37" Cursor="Hand" ToolTip="点击展开 · 拖到左右屏幕边缘自动收起 · 右键菜单">
      <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#43502F"/></Border.Effect>
      <Grid Margin="12,9,15,9"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="39" Height="39" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Ellipse Stroke="#E7EBDf" StrokeThickness="3"/><Path x:Name="BallProgress" Stroke="#9EAD76" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <TextBlock Text="¥" Foreground="#788955" FontWeight="SemiBold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="BallEarned" Text="¥ 0.00" FontSize="19" FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="1,4,0,0"><Ellipse x:Name="BallDot" Width="4" Height="4" Fill="#778D54" Margin="0,0,5,0"/><TextBlock x:Name="BallState" Text="正在计薪" FontSize="9" Foreground="#7E8870"/></StackPanel></StackPanel>
      </Grid>
    </Border>
     </Grid>
    </Grid>
   </Viewbox>
   <Border x:Name="DockTab" Visibility="Collapsed" Background="#657746" CornerRadius="8,0,0,8" Cursor="Hand" Margin="0,10" ToolTip="鼠标移入展开悬浮球">
     <TextBlock Text="⋮" Foreground="#EAF0DC" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
  </Grid>
</Window>
